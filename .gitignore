# Operating systems
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.iml
*.code-workspace
*.swp
*.swo

# Logs and local diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Node.js projects (including web/)
**/node_modules/
**/dist/
**/coverage/
**/.vite/
**/.npm/
**/*.tsbuildinfo
**/.eslintcache
**/.stylelintcache
**/.pnp.*
**/.yarn-integrity

# Android build state, local SDK files, device tooling, and signing material
android/**/.gradle/
android/**/.kotlin/
android/**/build/
android/**/local.properties
android/**/captures/
android/**/.externalNativeBuild/
android/**/.cxx/
android/**/*.apk
android/**/*.aab
android/**/output-metadata.json
android/**/*.hprof
android/**/*.jks
android/**/*.keystore
android/**/google-services.json

# Temporary files from document editors
docs/**/~$*
docs/**/*.tmp

# Local environment files
**/.env
**/.env.*
!**/.env.example

# Local AI/editor state. Shared project skills under .agents/ remain trackable.
.ai/
.ai-context/
.context/
.vibes/
.skills/
.cursor/
.cursorrules
.windsurfrules
.opencode/
